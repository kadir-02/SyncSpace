PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace
JWT_SECRET=your_super_secret_jwt_key

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EMAIL 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your.email@gmail.com"
SMTP_PASS="16 letter google password"
EMAIL_FROM=Cohvra <your.email@gmail.com>

# --- AI (optional; powers the channel summarizer) ---
# Easiest free option: Groq (no card). Get a key at https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=gsk_your_key_here
# Optional overrides:
AI_MODEL=openai/gpt-oss-120b
# AI_MODEL=llama-3.3-70b-versatile     (or llama-3.1-8b-instant for higher daily volume)
# AI_SUMMARIES_PER_HOUR=10
# AI_CHUNK_CHARS=6000                   (smaller = safer on free per-minute token limits)
# AI_MAX_CHUNKS=6
#
# Other providers:
#   AI_PROVIDER=huggingface   (needs pre-paid credits or PRO; free accounts get very little)
#   AI_PROVIDER=ollama        (local & private, no key; AI_MODEL=llama3.2)
#   or any OpenAI-compatible service: AI_BASE_URL=https://.../v1  AI_MODEL=...  AI_API_KEY=...
